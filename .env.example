# Cal.com API key: Cal.com -> Settings -> Developer -> API keys.
# Server-only: the booking routes read it, the browser never sees it.
CAL_API_KEY=

# GitHub: fine-grained personal access token, public repositories, read-only.
# Server-only. Never name this NEXT_PUBLIC_GITHUB_TOKEN.
# Set in .env.local and Vercel's Preview/Production environment settings.
GITHUB_TOKEN=

# Optional dedicated Vercel API token for hourly visitor-total refreshes.
# Server-only. Without it, the counter shows its dated, verified snapshot.
# Never copy your CLI login token or use a NEXT_PUBLIC_ prefix.
VERCEL_ANALYTICS_TOKEN=
